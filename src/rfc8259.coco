#!/usr/bin/env coconut-run

from typing import Mapping, Sequence, Literal


# rfc8259
type JSON_Null = None
type JSON_True = Literal[True]
type JSON_False = Literal[False]
type JSON_Number = int | float
type JSON_String = str
type JSON_Object[T <: JSON_Value] = Mapping[str, T]
type JSON_Array[T <: JSON_Value] = Sequence[T]
type JSON_Value[T <: JSON_Value] = JSON_Null | JSON_True | JSON_False | JSON_Number | JSON_String | JSON_Object[T] | JSON_Array[T]

